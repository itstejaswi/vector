{
  "name": "vector",
  "version": "1.0.0",
  "private": true,
  "description": "Vector — a browser-only live flight tracker. Point it anywhere on Earth and watch what is overhead.",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm -F web dev",
    "build": "pnpm -F web build",
    "preview": "pnpm -F web preview",
    "test": "vitest run",
    "typecheck": "tsc -p shared/tsconfig.json && pnpm -F web typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
